# Copie este arquivo para .env e troque os valores. NUNCA envie o .env para o GitHub.

# Banco de dados
POSTGRES_USER=postgres
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=checkpoint
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# JWT - use pelo menos 32 caracteres aleatórios
JWT_SECRET=troque-por-uma-chave-aleatoria-com-mais-de-32-caracteres
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Primeiro administrador (criado automaticamente se não existir nenhum)
ADMIN_MATRICULA=admin
ADMIN_SENHA=troque_esta_senha
ADMIN_NOME=Administrador
ADMIN_EMAIL=admin@checkpoint.local

# Contas de teste com senha (criadas ao iniciar, com um contrato de 300 h entre elas)
PROFESSOR_TESTE_MATRICULA=professor
PROFESSOR_TESTE_SENHA=troque_esta_senha
ALUNO_TESTE_MATRICULA=aluno
ALUNO_TESTE_SENHA=troque_esta_senha

# Ponto eletrônico
GEOFENCE_RAIO_METROS=200
MAX_HORAS_POR_REGISTRO=8
APP_TIMEZONE=America/Recife

# Provas de presença exigidas no ponto (true/false)
EXIGIR_QRCODE=true
EXIGIR_SELFIE=true
# QR Code ao vivo do professor: troca a cada N segundos (mínimo 10)
QR_AO_VIVO_SEGUNDOS=30

# Modo demonstração (botão "Conhecer o app" com aluno e professor de exemplo)
DEMO_HABILITADO=true

# Opcional: converte endereço em coordenadas automaticamente
GOOGLE_MAPS_API_KEY=

# Origens web liberadas no CORS (separadas por vírgula). Apps nativos não precisam.
CORS_ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006
